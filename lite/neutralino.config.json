{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.virtualjames.retrogamelibrary",
  "version": "1.3.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "server.*",
    "net.*",
    "window.*",
    "events.*",
    "computer.getArch"
  ],
  "globalVariables": {},
  "modes": {
    "window": {
      "title": "Retro Game Library",
      "width": 1280,
      "height": 900,
      "minWidth": 420,
      "minHeight": 500,
      "center": true,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "exitProcessOnClose": true,
      "useSavedState": false
    },
    "cloud": {
      "url": "/",
      "nativeAllowList": [
        "app.*",
        "os.*",
        "filesystem.*",
        "server.*",
        "net.*",
        "window.*",
        "events.*",
        "computer.getArch"
      ]
    }
  },
  "cli": {
    "binaryName": "retro-game-library",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}